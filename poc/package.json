{
  "name": "@amber/pocs",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:telegram": "pnpm --filter @amber/telegram-poc test:live",
    "test:messaging": "pnpm --filter @amber/messaging-poc test:live"
  }
}
